# =============================================================================
# ORA Navigator - Environment Variables Template
# =============================================================================
# Copy this to .env and fill in your actual values
# NEVER commit .env with real credentials!
#
# For Cloud Run: secrets are stored in Secret Manager (see deploy-cloudrun.sh)
# =============================================================================

# -----------------------------------------------------------------------------
# HOW TO RUN LOCALLY  (two terminals - verified 2026-08-31)
# -----------------------------------------------------------------------------
#   1. backend    cd <repo-root>/backend
#                 python3 -m uvicorn main:app --host 127.0.0.1 --port 5002 --reload
#   2. frontend   cd <repo-root>/frontend
#                 npm run dev -- --port 3001
#   then open     http://localhost:3001
#
# No venv activate: the deps live in the base python (`python3`). backend/main.py
# loads THIS file itself (../.env), so no env prefix is needed on the command.
#
# WHY THOSE TWO PORTS MUST MATCH: the frontend calls the backend DIRECTLY at
# http://127.0.0.1:5002, hardcoded in src/lib/apiBase.js and used by 23 files.
# It does NOT go through vite's proxy - that proxy targets port 8000
# (VITE_BACKEND_PORT default) and returns 500, but nothing in the app uses it.
# And `--port 3001` is not optional: vite defaults to 5173, and CORS_ORIGINS
# below allows ONLY 3001 and 5173 (narrower than main.py's built-in default).
#
# THE TRAP: if 3001 is already taken, vite does NOT fail - it prints "Port 3001
# is in use, trying another one..." and quietly starts on 3002. The page loads
# fine and every API call is then blocked by CORS, because 3002 is not in the
# list. So read vite's "Local:" line, and if it does not say 3001, stop it,
# free 3001 with the pkill below, and start again. Same for the backend: two
# `Address already in use` lines mean YOUR server never started and the one
# answering on 5002 is an older process.
#
# CHAT NEEDS A THIRD SERVICE (the ADK agent on 8081), and `google-adk` is not
# installed locally - install it once:
#   python3 -m pip install google-adk
#   cd <repo-root>/adk_agent && adk web . --port 8081
# Without it, /health reports "ai":"offline" (that field is the ADK agent's
# health, NOT Gemini's) and chat answers "trouble connecting to my knowledge
# base". Everything else - proposals, Draft Review, Section Check, solicitation
# reads - works without it: those call Gemini directly through local ADC.
#
# ALREADY RUNNING? These fail with "address already in use" until you stop them:
#   lsof -nP -iTCP:3001 -iTCP:5002 -sTCP:LISTEN
#   pkill -f "uvicorn main:app" ; pkill -f "vite --port 3001"
# -----------------------------------------------------------------------------

# --- Vertex AI Agent (ADK) ---
USE_VERTEX_AGENT=true
ADK_APP_NAME=ora_navigator_unified

# For local development:
ADK_BASE_URL=http://127.0.0.1:8081

# For Cloud Run (auto-set during deployment):
# ADK_BASE_URL=https://oranavigator-adk-ollhkgeova-uc.a.run.app

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>

# --- Database (Cloud SQL MySQL) ---
# Local dev: TCP+SSL to public IP. Cloud Run: unix socket via Cloud SQL Auth Proxy.
DATABASE_URL=

# --- Authentication ---
JWT_SECRET=<generate-64-char-random-string>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240

# --- Admin Account ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>

# --- App URL (used in verification emails, password reset links) ---
APP_URL=https://ora.inavigator.ai

# --- URL solicitation scraping (funder sites that block cloud IPs) ---
# Firecrawl (preferred): free key at https://firecrawl.dev
FIRECRAWL_API_KEY=
# Jina reader (fallback): optional free key at https://jina.ai/reader
JINA_API_KEY=

# --- OpenAI (TTS voice feature only; optional) ---
OPENAI_API_KEY=

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://127.0.0.1:3001,http://127.0.0.1:5173
